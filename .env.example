# Copie para .env e preencha. Nunca commitar .env (ver .gitignore).

# --- Banco MCP / Open Finance (obrigatório) ---
# Token Bearer permanente do provedor Banco MCP (mcp.ai)
MCP_AI_TOKEN=
# URL do servidor MCP (Streamable HTTP)
MCP_URL=
# Base REST Open Finance usada pelo cliente de dados
OPENFINANCE_BASE=

# --- Chat com IA (opcional; padrão = Ollama local) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=minimax-m3:cloud
# LLM_API_KEY=ollama
